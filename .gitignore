# Сборка и её выводы — не исходники
bin/
obj/
dist/
*.user
*.suo
.vs/

# Каталог, в который кладётся сборка, пока панель владельца ещё работает (её `dist` занят):
# он обязан лежать ВНУТРИ дерева — проверки ищут корень репозитория по DshPanel.slnx, —
# но исходником не является и в репозиторий не идёт.
upd-build/

# Версия установщика: её пишет installer\build-installer.ps1 из <Version> проекта, и руками
# этот файл не правят. Единственный источник версии — src\DshPanel\DshPanel.csproj.
installer/appversion.iss

# Замок зависимостей — НАОБОРОТ, в репозитории: он и есть воспроизводимость.
!packages.lock.json

