<?xml version="1.0" encoding="utf-8"?>
<!--
  Источники пакетов. Файл лежит в корне решения и действует на всё дерево:
  пользовательский NuGet.config вне папки сборке недоступен, а зависеть от
  настроек машины сборщика мы не хотим.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
