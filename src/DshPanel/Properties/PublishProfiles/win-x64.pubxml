<?xml version="1.0" encoding="utf-8"?>
<!--
  Профиль публикации раздачи. Запуск:

      dotnet publish src\DshPanel\DshPanel.csproj -p:PublishProfile=win-x64 -o dist

  Почему профиль, а не ключи в командной строке: забытый ключ даёт ДРУГУЮ сборку,
  чем проверяли. Профиль лежит в репозитории, поэтому «как собирать раздачу» —
  это часть кода, а не память сборщика.

  Результат: один файл DshPanel.exe, внутри весь .NET, Skia и HarfBuzz.
  Проверено на чистой Windows 10 без .NET и без VC++ — запускается.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>dist\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Сжатие: 87.8 МБ -> 47 МБ. Первый запуск чуть дольше (распаковка), зато раздача вдвое меньше. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
