<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DshPanel.Views.UnsavedChangesWindow"
        Width="560" SizeToContent="Height"
        MinWidth="440"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- Текстов в разметке нет: заголовок, вопрос и подписи кнопок ставит конструктор из PanelStrings. -->
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="14" />

    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" />
      <Button x:Name="DiscardButton" />
      <Button x:Name="SaveButton" />
    </StackPanel>
  </StackPanel>
</Window>
