<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DshPanel.Views.MainWindow"
        Width="640" Height="640"
        MinWidth="560" MinHeight="420">
  <!--
    НИ ОДНОГО текста в разметке: подписи ставятся кодом окна из PanelStrings, а тот берёт их
    из словаря (`Localization\ru.json`). Так текст перестаёт быть «строкой в разметке», которую
    при переносе на три языка находят поиском по всему дереву, и попадает в одну опись ключей.
  -->
  <!--
    Прокрутка контента — не украшение. Дефект Д2 (живой просмотр владельца 26.09.2026): когда
    панель находит ЧУЖОЙ работающий сервер, карточка «Найден работающий DSH…» удлиняет
    содержимое, и на минимальной высоте окна низ уезжал за край — кнопки нижнего ряда
    становились недостижимы вовсе. Горизонтальную прокрутку гасим намеренно: с ней содержимое
    измерялось бы бесконечной шириной, и перенос строк в подсказках перестал бы работать.
  -->
  <ScrollViewer x:Name="MainContentScroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <!--
      ⚠️ ШАГ РИТМА 16/12 ВНУТРИ ГЛАВНОГО ОКНА, А НЕ 24/16 (DEF-050, 2.4.0). Замер кадра p8
      на дефолтном 640×640: содержимое 695 точек при окне 640 — нижний ряд карточки баланса
      («Обновить баланс», «Пики и тарифы…») стоял на самой границе и был ОБРЕЗАН снизу, то есть
      действия окна требовали прокрутки сразу после открытия (D-16). Теперь содержимое ужимается
      в 640 по вертикали: поле окна 16 (было 24), промежуток между карточками 12 (было 16),
      промежуток внутри карточек 8 (было 12) — все числа из шкалы 4/8/12/16/24, и поле нижнего
      ряда до края окна остаётся ≥8. Воздух САМОЙ карточки (Padding 24) не тронут — он один
      на все окна и сторожится `SettingsLookTests.Воздух_карточек_один_на_все_окна_и_не_меньше_24`.
      Стережёт новое число `SelectionAndTodayTests.Нижний_ряд_главного_окна_на_640x640_...`.
    -->
    <StackPanel x:Name="MainContent" Margin="16" Spacing="12">
      <!--
        ШАПКА: слева имя панели, справа — двери в другие окна. Решение владельца 27.09.2026:
        «кнопка настройки не должна быть в одном ряду с кнопками управления сервером». Поэтому
        «Копии и восстановление…» и «Настройки…» стоят ЗДЕСЬ, а в карточке сервера остались
        только действия с сервером.

        ⚠️ Дверь «О программе…» ушла ОТСЮДА в настройки (решение владельца 27.09.2026:
        «„о программе“ не туда воткнул. Предлагаю перенести вообще в настройки»). Само окно
        осталось одно и то же — переехала дверь.
      -->
      <Grid ColumnDefinitions="*,Auto">
        <!-- ЛОГОТИП ВМЕСТО ПРОСТОЙ НАДПИСИ — решение владельца 28.09.2026, вариант A из четырёх
             предложенных (`docs\DESIGN.md` п. 34, кадр `assets\logo-options.png`): компактный знак
             с монограммой и текстовое имя рядом, в одну строку.

             ⚠️ Знак рисуется ЗДЕСЬ, разметкой, из тех же средств, что всё остальное: рамка-квадрат
             с закруглением, внутри буквы. Ни картинки, ни шрифтового значка — панель раздаётся
             одним exe, и шрифтовой значок на чужой машине оказался бы пустым квадратом.
             Буквы — из строки `AppMonogram`: они латинские во всех трёх языках (имя изделия не
             переводят), а вот ИМЯ рядом — переводится, поэтому «DSH 面板 2.0» на китайском.

             ⚠️ Высоту шапки знак НЕ увеличивает — ради этого вариант A и выбран: 26 точек против
             24 у текста, и строка остаётся одной. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="6"
                  Background="{DynamicResource AccentButtonBackground}"
                  VerticalAlignment="Center">
            <TextBlock x:Name="LogoMonogramText" FontSize="9" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="AppTitleText" FontSize="20" FontWeight="SemiBold"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="BackupsButton" />
          <Button x:Name="SettingsButton" />
        </StackPanel>
      </Grid>

      <!-- Карточка сервера: вид карточки — общий (`Border.card` в App.axaml), здесь только
           содержимое. Отдельная карточка нашему виду больше не нужна: тень, скругление,
           подложка и рамка объявлены один раз на всё приложение. -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <!-- Состояние — ЦВЕТОМ и кружком: тон решает `TrayStatus.ServerTone` (тот же, что
               у строки сервера в меню значка), а кисть берётся у темы. Значит «работает»,
               «не работает» и «панель не знает» выглядят одинаково в окне и в значке. -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border x:Name="ServerDot" Classes="dot" />
            <TextBlock x:Name="ServerStatusText" FontSize="18" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock x:Name="ServerDetailText" Text="" TextWrapping="Wrap" Opacity="0.75" />

          <!-- Ряд кнопок сервера — ПЕРЕНОСИМЫЙ (WrapPanel), а не жёсткий. Ряд растёт с каждой
               новой дверью, а минимальная ширина окна — 640: дефект Д2 был ровно про то, что
               содержимое переставало вмещаться и нижние кнопки становились недостижимы.
               Здесь стоят ТОЛЬКО действия с сервером: ни настроек, ни копий рядом с «Запустить»
               быть не должно (решение владельца 27.09.2026).
               Отступы заданы полями, а не Spacing: так ряд переносится одинаково на всех
               версиях каркаса. -->
          <WrapPanel Orientation="Horizontal">
            <!-- «Запустить» — ГЛАВНОЕ действие окна, и оно окрашено акцентом темы (класс accent):
                 у окна одно действие, которое поднимает работу, и оно обязано отличаться
                 от «Остановить» и «Отвязаться» (решение владельца 27.09.2026). -->
            <Button x:Name="StartServerButton" Classes="accent" Margin="0,0,12,8" />
            <!-- «Перезапустить» стоит СТРОГО между «Запустить» и «Остановить»: перезапуск —
                 ровно эти два действия подряд, и человек ищет его именно здесь. -->
            <Button x:Name="RestartServerButton" Margin="0,0,12,8" />
            <Button x:Name="StopServerButton" Margin="0,0,12,8" />
            <Button x:Name="DetachServerButton" IsVisible="False" Margin="0,0,12,8" />

            <!-- «ПОДНЯТЬ СВОЙ СЕРВЕР ЗАНОВО» — единственный путь из состояния «сервер на порту
                 поднят не панелью» (решение владельца 13.10.2026, ответы 1 и 2).

                 ⚠️ ЭТО НЕ ТО ЖЕ, ЧТО «Отвязаться»: там человек САМ взял чужой сервер под
                 управление и может вернуть как было, а здесь панель этим сервером НЕ управляет —
                 своей ссылки входа у неё нет, вопросы агента на телефон не придут, обновить сервер
                 DSH нельзя. Поэтому у этих двух положений РАЗНЫЕ слова и РАЗНЫЕ кнопки. -->
            <Button x:Name="RecoverOwnServerButton" IsVisible="False" Margin="0,0,12,8" />
          </WrapPanel>

          <!-- ПОЧЕМУ ТАК И ЧТО ЗА ЭТИМ СЛЕДУЕТ. Постоянная строка — только у ЭТОГО положения:
               у «взятого чужого» всё сказано подсказкой кнопки. Здесь молчание было бы хуже —
               человек видит работающий сервер и не понимает, почему не работает телефон. -->
          <TextBlock x:Name="NotStartedByPanelText" Classes="hint" TextWrapping="Wrap" IsVisible="False" />

          <!-- Дверь в панель, которую поднимает сервер: браузер открывается ТОЛЬКО по щелчку
               человека. Сама ссылка (в ней токен) не показывается нигде — ни текстом, ни
               подсказкой: сюда выходит лишь «можно нажать» и причина отказа словами.

               ⚠️ ПОСТОЯННОЙ НАДПИСИ ПОД КНОПКОЙ ЗДЕСЬ НЕТ (замечание владельца 28.09.2026):
               она читалась как ОБРАЩЕНИЕ ПРОГРАММЫ к человеку («Откроется работа вашего агента
               в браузере — по вашему щелчку и только по нему»), то есть повторяла то, что делает
               сама кнопка, и занимала строку на виду. Причина недоступности осталась — но там,
               где её ищут: в ПОДСКАЗКЕ кнопки (её ставит код из строки словаря, она меняется
               вместе с состоянием сервера). -->
          <Button x:Name="OpenAgentButton" HorizontalAlignment="Left" />

          <!-- Найденный работающий сервер, который панель не поднимала. Панель показывает его
               и спрашивает, а не встраивается молча (решение владельца 24.09.2026). Это вставка
               ВНУТРИ карточки, поэтому у неё не общая тень карточки, а своя рамка из темы.

               ⚠️ НАЙДЕННЫХ БЫВАЕТ ДВА (решение владельца 10.10.2026): чужой на 3080 и наш движок
               другой версии рядом. Тогда строки идут списком с пометкой «наш движок (версия)» /
               «чужой», и у КАЖДОГО своя кнопка с портом — иначе человек не знает, какой берёт.
               Один найденный показывается прежней строкой и прежней кнопкой без порта. -->
          <Border x:Name="FoundServerPanel" IsVisible="False"
                  BorderThickness="1" CornerRadius="4" Padding="12"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="8">
              <TextBlock x:Name="FoundServerText" Text="" TextWrapping="Wrap" FontWeight="SemiBold" />
              <TextBlock x:Name="AdoptNoteText" Classes="hint" Text="" />
              <Button x:Name="AdoptServerButton" HorizontalAlignment="Left" />
              <StackPanel x:Name="FoundServersList" Spacing="8" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock x:Name="BalanceTitleText" Classes="sectionTitle" />

          <!--
            АКТИВНЫЙ АГЕНТ МЕНЯЕТСЯ ЗДЕСЬ ЖЕ (решение владельца 27.09.2026): «активный агент так же
            должен быстро меняться в главном окне, где указан баланс, наверное там должен быть
            выпадающий список». Смена уходит ВЛАДЕЛЬЦУ НАСТРОЕК — тем же путём, что кнопка
            «Сохранить» в настройках, и второго способа записи в панели нет.

            ⚠️ Пока агент ОДИН, список недоступен и говорит об этом словами под собой: живой
            выпадающий список из одного пункта обещал бы выбор, которого нет.
          -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="ActiveAgentLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="AgentBox" Width="200" />
          </StackPanel>
          <TextBlock x:Name="AgentNoteText" Classes="hint" Text="" />

          <TextBlock x:Name="BalanceStatusText" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="BalanceDetailText" Text="" TextWrapping="Wrap" Opacity="0.75" />

          <!-- Тариф — тоже ЦВЕТОМ: пик дороже, вне пика вдвое дешевле. Тон берётся у того же
               решения, что красит строку тарифа в меню значка (`TrayStatus.PeakTone`). -->
          <TextBlock x:Name="PeakText" Text="" FontSize="16" FontWeight="SemiBold" />
          <TextBlock x:Name="PeakNextText" Text="" TextWrapping="Wrap" Opacity="0.85" />
          <!--
            ДВЕ ДАТЫ — ДВЕ СТРОКИ (замечание владельца 20.10.2026, F-5, вариант «б»).
            Первая — своя: когда цены разбирала САМА панель («Пики: проверено 19.10.2026»).
            Вторая — из ПРОФИЛЯ ДВИЖКА и с подписью источника: это не дата проверки панели,
            и читать её как свою человек не должен. Пустая вторая строка не показывается.
          -->
          <TextBlock x:Name="PeakScheduleText" Classes="hint" Text="" />
          <TextBlock x:Name="PeakProfileText" Classes="hint" Text="" IsVisible="False" />

          <!-- Две кнопки карточки баланса — ПЕРЕНОСИМЫМ рядом (WrapPanel), как ряд сервера:
               минимальная ширина окна 640, и жёсткий ряд однажды перестал бы вмещаться
               (дефект Д2). Отступы заданы полями, а не Spacing, — тем же способом, что у ряда
               сервера: так ряд переносится одинаково на всех версиях каркаса. -->
          <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="RefreshBalanceButton" Margin="0,0,12,8" />
            <Button x:Name="PeakButton" Margin="0,0,12,8" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
